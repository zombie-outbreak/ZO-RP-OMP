        <item id="51" weight="15" min_quantity="1" max_quantity="1">Lighter</item>
        
        <!-- Uncommon (Weight: 5-10) -->
        <item id="24" weight="10" min_quantity="1" max_quantity="1">Empty Canteen</item>
        <item id="46" weight="8" min_quantity="1" max_quantity="1">Flashlight</item>
